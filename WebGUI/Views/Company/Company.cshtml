@model DTO.Model.Company

@{
    ViewBag.Title = Model == null ? "Add Company" : "Company";
}

<h2>@ViewBag.Title</h2>

@if (Model == null)
{
    using (Html.BeginForm("AddCompany", "Company"))
    {
        @Html.ValidationSummary()
        @Html.LabelFor(m => m.Name)
        @Html.EditorFor(m => m.Name)
        @Html.ValidationMessageFor(m => m.Name)

        <button type="submit">OK</button>
    }
}
else
{
    <p>Name: @Model.Name (ID: @Model.CompanyId)</p>
    <h3>Employees</h3>
    foreach (var employee in Model.Employees)
    {
        <p>@employee.Name (ID: @employee.EmployeeId), years employed: @employee.YearsEmployed</p>
    }
}
