@model DTO.Model.Employee

@{
    ViewBag.Title = Model == null ? "Add Employee" : "Employee";
}

<h2>@ViewBag.Title</h2>

@if (Model == null)
{
    using (Html.BeginForm("AddEmployee", "Employee"))
    {
        @Html.ValidationSummary()
        @Html.LabelFor(m => m.Name)
        @Html.EditorFor(m => m.Name)
        @Html.ValidationMessageFor(m => m.Name)
        @Html.LabelFor(m => m.YearsEmployed)
        @Html.EditorFor(m => m.YearsEmployed)
        @Html.ValidationMessageFor(m => m.YearsEmployed)
        @Html.LabelFor(m => m.CompanyId)
        @Html.EditorFor(m => m.CompanyId)

        <button type="submit">OK</button>
    }
}
else
{
    <p>Name: @Model.Name (ID: @Model.EmployeeId)</p>
    <p>Company ID: @Model.CompanyId</p>
    <p>Years employed: @Model.YearsEmployed</p>
}
